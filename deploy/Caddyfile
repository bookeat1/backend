# Reverse proxy for the BookEat backend.
#
# {$SITE_ADDRESS} comes from docker-compose.yml's `environment:` (sourced
# from .env). Today, with DNS not yet delegated, it is `http://:80` — Caddy
# serves plain HTTP on port 80, answering on the server's bare IP, no TLS.
#
# When DNS is delegated, the ONLY change needed is the SITE_ADDRESS value in
# .env:
#   prod:  SITE_ADDRESS=backend.book-eat.com
#   test:  SITE_ADDRESS=test.backend.book-eat.com
# then `docker compose up -d caddy` (or `docker compose restart caddy`).
# Caddy will request/renew a Let's Encrypt certificate automatically and start
# terminating TLS on :443, redirecting :80 to :443 — no other file changes.

{$SITE_ADDRESS:http://:80} {
	encode gzip zstd

	log {
		output stdout
		format json
	}

	# Static preview of the guest mobile app (Expo web build). Served before
	# the proxy so that /preview never reaches the backend. It is an SPA: any
	# path that does not exist on disk falls back to index.html and the client
	# resolves the route.
	handle_path /preview* {
		root * /srv/preview
		try_files {path} /index.html
		file_server
	}

	# Static preview of the venue panel (Next.js static export built with
	# basePath=/admin-preview). Served before the proxy so that /admin-preview
	# never reaches the backend. handle_path strips the prefix, so a request for
	# /admin-preview/_next/... maps onto files at the root of admin-preview.
	# With trailingSlash every page is a directory holding index.html; unknown
	# routes fall back to the root index.html.
	#
	# /srv/preview/admin-preview is a SYMLINK to the current release directory
	# under /srv/preview/admin-releases/. The deploy pipeline in bookeat1/frontend
	# (.github/workflows/deploy-admin-test.yml) uploads a new release next to it
	# and moves that symlink, so a half-finished upload is never served. Caddy
	# follows the symlink on every request; swapping it needs no reload.
	handle_path /admin-preview* {
		root * /srv/preview/admin-preview
		try_files {path} {path}/index.html /index.html
		file_server
	}

	# Liveness check does not need to go through the app's readiness path;
	# Caddy just proxies everything, including /health and /health/ready.
	reverse_proxy app:8080 {
		health_uri /health
		health_interval 15s
		health_timeout 3s
	}
}
