# Copy to deploy/.env on the server. chmod 600, owner ubuntu. NEVER commit the
# real file — it holds live secrets. See deploy/README.md for the full runbook.

# ---------------------------------------------------------------------------
# Image (used by docker-compose.yml `app`/`worker`/`migrate` services)
# ---------------------------------------------------------------------------
# Set by CI on deploy (ghcr.io/bookeat1/backend). For a manual first bring-up
# on a fresh box, leave IMAGE_TAG=local and run `docker compose build`.
IMAGE_REPO=ghcr.io/bookeat1/backend
IMAGE_TAG=local
# Written automatically by deploy/scripts/remote-deploy.sh after a successful
# deploy (the tag that was CURRENT right before this one). Used by
# deploy/scripts/rollback.sh for the one-line manual rollback. Leave blank on
# first bring-up — there is nothing to roll back to yet.
PREVIOUS_IMAGE_TAG=

# ---------------------------------------------------------------------------
# Reverse proxy (Caddyfile)
# ---------------------------------------------------------------------------
# http://:80 = plain HTTP on the bare IP (current state, DNS not delegated).
# Flip to the real hostname once DNS resolves here; Caddy then gets TLS
# automatically. See deploy/README.md "DNS cutover" section.
#   prod: SITE_ADDRESS=backend.book-eat.com
#   test: SITE_ADDRESS=test.backend.book-eat.com
SITE_ADDRESS=http://:80

# ---------------------------------------------------------------------------
# Application (internal/bootstrap/config.go)
# ---------------------------------------------------------------------------
APP_NAME=backend-core
# development | staging | production — production also disables /docs.
APP_ENV=production
APP_URL=0.0.0.0:8080
APP_LOG_LEVEL=info
# Comma-separated allowed CORS origins. "*" = any origin, no credentials.
APP_CORS_ORIGINS=*
# Comma-separated IPs/CIDRs trusted to set X-Forwarded-For — only Caddy's own
# address on the compose network should be here (gin's ClientIP() otherwise
# falls back to the raw TCP peer, i.e. Caddy's address for every request,
# which is safe but not per-real-client — see AppConfig.TrustedProxies's doc).
# TODO(verify): this compose file defines no custom `networks:` section, so
# the bridge subnet is whatever Docker assigns per project — find Caddy's
# actual address with `docker compose exec app getent hosts caddy` (or
# `docker network inspect` the project's default network) after first
# bring-up and set it here; do not guess a subnet.
APP_TRUSTED_PROXIES=

# Per-client-IP request budgets (middleware.RateLimit) — see
# .env.example (repo root) for the full list of RATE_LIMIT_* variables and
# their defaults; only listing the master switch here since the defaults are
# sane for prod as-is.
RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# PostgreSQL — application connection (DB_HOST is set by compose to
# "postgres"; do not override it here).
# ---------------------------------------------------------------------------
DB_PORT=5432
DB_DATABASE=bookeat
DB_USERNAME=bookeat
# Generate: openssl rand -base64 32
DB_PASSWORD=
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m

# ---------------------------------------------------------------------------
# PostgreSQL — server tuning (docker-compose.yml `postgres` service command).
# Different per host; see deploy/README.md for the numbers used on prod
# (8 vCPU / 15GB RAM) vs test (4 vCPU / 3GB RAM).
# ---------------------------------------------------------------------------
PG_SHARED_BUFFERS=256MB
PG_WORK_MEM=8MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_MAINTENANCE_WORK_MEM=64MB
PG_MAX_CONNECTIONS=100
PG_MEM_LIMIT=1g
APP_MEM_LIMIT=512m
WORKER_MEM_LIMIT=256m

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# RSA private key, PEM, one line with literal \n (generate:
# `openssl genrsa 2048 | awk '{printf "%s\\n", $0}'`). NEVER a shared/dev key
# in a real environment.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_KID=bookeat-prod-2026-07
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_OTP_TTL=5m
AUTH_OTP_RATE_PER_MIN=1
AUTH_OTP_RATE_PER_HOUR=5
# Must be false outside development — echoes the OTP code in the API response.
AUTH_OTP_DEV_EXPOSE=false

# --- App Store / Google Play review account ---------------------------------
# ONE phone number that logs in with a fixed code and NO message sent anywhere.
# It exists because an App Review reviewer cannot receive a Telegram/WhatsApp/
# SMS code, and "the reviewer could not log in" is one of the most common
# rejection reasons. The pair below is what goes into App Review Information;
# the app itself knows nothing about it (no hidden gesture, no debug build).
#
# Rules, enforced in internal/usecase/auth/test_account.go:
#   - BOTH empty = the feature does not exist. Setting exactly one of them is a
#     STARTUP ERROR, not a silent "off".
#   - This number never reaches a provider and writes no otp_codes row, so it is
#     exempt from the per-phone AUTH_OTP_RATE_PER_MIN/_PER_HOUR budget (a
#     reviewer tapping "resend" must not lock themselves out). The per-IP
#     RATE_LIMIT_STRICT_* budget still applies to it like to any other number.
#   - Every request / login attempt / attempted takeover of it is logged at WARN
#     (auth.test_account_*), because those lines are its only audit trail.
#   - Use a number that can never belong to a real guest, and rotate the code
#     between submissions. Treat the code as a shared password, not a secret.
AUTH_TEST_ACCOUNT_PHONE=
AUTH_TEST_ACCOUNT_CODE=

# ---------------------------------------------------------------------------
# OTP delivery (login codes): Telegram Gateway -> WhatsApp -> SMS
# ---------------------------------------------------------------------------
# A channel is enabled ONLY when its credentials are present. With none of them
# set the backend keeps the stub sender: nothing crashes, but NO guest can log
# in on this contour (the log says so, loudly, at WARN on every request).
# The per-phone rate limits above (AUTH_OTP_RATE_PER_MIN / _PER_HOUR) apply to
# every attempt, including one where no channel accepted the code.
OTP_CHANNEL_ORDER=telegram_gateway,whatsapp,sms
OTP_SEND_TIMEOUT=5s
# Budget for the WHOLE waterfall (all fallbacks together). Must stay below the
# HTTP server WriteTimeout (15s), otherwise the guest's connection dies while we
# are still paying providers.
OTP_DELIVERY_BUDGET=12s

# --- Telegram Gateway (https://gateway.telegram.org) -------------------------
# The PAID product that delivers a code to a phone number inside Telegram. This
# is NOT the notifications bot (TELEGRAM_NOTIFY_BOT_TOKEN) and needs its own
# account and its own topped-up balance.
#   Token: gateway.telegram.org -> Account -> API token.
OTP_TELEGRAM_GATEWAY_TOKEN=
# Optional: username of a VERIFIED channel to send from. Leave empty to use
# Telegram's own verification sender.
OTP_TELEGRAM_GATEWAY_SENDER_USERNAME=

# --- WhatsApp (Meta Cloud API) ----------------------------------------------
# developers.facebook.com -> your app -> WhatsApp:
#   OTP_WHATSAPP_ACCESS_TOKEN    — System User token with
#                                  whatsapp_business_messaging (NOT the 24h
#                                  temporary test token).
#   OTP_WHATSAPP_PHONE_NUMBER_ID — API Setup -> "Phone number ID".
#   OTP_WHATSAPP_TEMPLATE_NAME   — an APPROVED template in the AUTHENTICATION
#                                  category (free-form text is not allowed for
#                                  login codes).
OTP_WHATSAPP_ACCESS_TOKEN=
OTP_WHATSAPP_PHONE_NUMBER_ID=
OTP_WHATSAPP_TEMPLATE_NAME=bookeat_otp_en
# Must match the language the template was APPROVED in, or every send is
# rejected. "en" for bookeat_otp_en — confirmed by a live delivered message.
OTP_WHATSAPP_TEMPLATE_LANG=en
OTP_WHATSAPP_API_VERSION=v22.0
# Must mirror the approved template: true when it has the "Copy code" button
# (Meta's default for authentication templates), false when it does not.
# A wrong value here makes EVERY WhatsApp send fail with a parameter mismatch.
OTP_WHATSAPP_COPY_CODE_BUTTON=true

# --- SMS (last resort, most expensive) --------------------------------------
# Empty = no SMS channel. "twilio" or "mobizon" enable the matching provider;
# the guest's remembered channel is "sms" either way, so providers can be
# swapped without invalidating the memory.
OTP_SMS_PROVIDER=
# Twilio (console.twilio.com -> Account Info). Set either the From number or a
# Messaging Service SID (the service wins when both are present).
OTP_SMS_TWILIO_ACCOUNT_SID=
OTP_SMS_TWILIO_AUTH_TOKEN=
OTP_SMS_TWILIO_FROM=
OTP_SMS_TWILIO_MESSAGING_SERVICE_SID=
# Mobizon (mobizon.kz -> Настройки -> API) — what the OLD system delivers KZ
# codes with today. The sender name is optional and must be APPROVED before use;
# an unapproved name is rejected per message.
OTP_SMS_MOBIZON_API_KEY=
OTP_SMS_MOBIZON_SENDER=

# ---------------------------------------------------------------------------
# Booking policy (global defaults, per-venue overridable — see config.go)
# ---------------------------------------------------------------------------
BOOKING_DEFAULT_DURATION_MINUTES=90
BOOKING_DEFAULT_BUFFER_MINUTES=0
BOOKING_DEFAULT_LEAD_MINUTES=60
BOOKING_DEFAULT_HORIZON_DAYS=60
BOOKING_DEFAULT_CANCEL_DEADLINE_MINUTES=180
BOOKING_DEFAULT_CONFIRM_SLA_MINUTES=120
BOOKING_DEFAULT_MAX_GUESTS=20
BOOKING_DEFAULT_AUTO_CONFIRM=true
BOOKING_TIMEZONE_FALLBACK=Asia/Almaty
BOOKING_RATE_LIMIT=10
BOOKING_RATE_WINDOW=1h
BOOKING_SLOT_STEP_MINUTES=30

# ---------------------------------------------------------------------------
# Background worker (cmd/worker)
# ---------------------------------------------------------------------------
WORKER_TICK_INTERVAL=1m
WORKER_NO_SHOW_GRACE=30m
WORKER_BATCH_SIZE=100

# ---------------------------------------------------------------------------
# Payments — master switch off by default (spec: a deliberate act to enable).
# Acquirer credentials never reach the DB, only env — see
# internal/infrastructure/payment/{freedompay,tiptoppay}/config.go.
# ---------------------------------------------------------------------------
PAYMENTS_ENABLED=false
PAYMENTS_DEFAULT_PROVIDER=freedompay
PAYMENTS_SERVICE_FEE_BPS=350
# Withheld from a guest's refund to cover the acquirer's cost of reversing the
# payment, in basis points (100 = 1%). Owner decision 2026-07-25: 0 — nothing is
# taken off the guest's refund by default.
PAYMENTS_REFUND_ACQUIRING_BPS=0
# The acquirer's per-operation FLOOR in tiyn — the "минимум 25 ₸" half of
# FreedomPay's "3,5% мин 25 ₸" tariff. Without it a small deposit leaves the
# venue short, because the percentage markup would be less than the fee the
# acquirer actually takes. 0 = the tariff is pure percent.
PAYMENTS_ACQUIRER_MIN_FEE_MINOR=2500
# Per-acquirer override of the line above, because keeping (or returning) the fee
# on a reversal is the acquirer's rule, not ours. Unset = use the global rate;
# an explicit 0 means "this acquirer charges nothing to reverse".
# PAYMENTS_REFUND_ACQUIRING_BPS_FREEDOMPAY=0
# PAYMENTS_REFUND_ACQUIRING_BPS_TIPTOPPAY=0
# PAYMENTS_REFUND_ACQUIRING_BPS_PARTNERSPAY=0
# PAYMENTS_REFUND_ACQUIRING_BPS_KASPI=0
PAYMENTS_DEPOSIT_DEFAULT_MINOR=0
PAYMENTS_HOLD_TTL=96h
# This deploy's own externally-reachable origin (no trailing slash) — builds
# the FreedomPay webhook CallbackURL server-side. Required for guest checkout
# to work at all once payments go live.
PAYMENTS_PUBLIC_BASE_URL=https://api.bookeat.kz

# FreedomPay (leave blank until payments go live; PAYMENTS_ENABLED=false makes
# these inert)
FREEDOMPAY_API_URL=https://api.freedompay.kz
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
FREEDOMPAY_RESULT_SCRIPT_NAME=freedompay
FREEDOMPAY_TESTING_MODE=false

# TipTopPay (leave blank until payments go live)
TIPTOPPAY_API_URL=https://api.tiptoppay.kz
TIPTOPPAY_PUBLIC_ID=
TIPTOPPAY_API_SECRET=
TIPTOPPAY_TEST_MODE=false

# Kaspi Pay — reached through OUR OWN multi-tenant Kaspi service
# (kaspi.book-eat.com), not Kaspi directly. The adapter is SKIPPED entirely
# unless both KASPI_COMPANY_API_KEYS and KASPI_WEBHOOK_SECRETS are set, so an
# unconfigured deployment simply has no Kaspi provider.
#
# !! Kaspi has NO SANDBOX. Every payment link this creates is real money.
KASPI_API_URL=https://kaspi.book-eat.com
# "<companyId>=<key>,<companyId>=<key>" — one X-Api-Key per company in the
# Kaspi service. A venue is pointed at a company from the admin panel
# (PUT /admin/restaurants/:id/payment-settings/acquirer-account, superadmin),
# which stores ONLY the company id; the key lives here and nowhere else.
KASPI_COMPANY_API_KEYS=
# "<companyId>=<secret>,…" — HMAC-SHA256 secrets of the webhook subscriptions
# the Kaspi service delivers to POST /api/v1/webhooks/payments/kaspi
# (header X-Webhook-Signature: sha256=<hex>). A single bare value is accepted
# as one shared secret.
KASPI_WEBHOOK_SECRETS=
# Optional: the Kaspi service sits behind Caddy basic auth on everything except
# its own /webhooks* paths. Leave blank when reaching it on a private network.
KASPI_BASIC_AUTH_USER=
KASPI_BASIC_AUTH_PASSWORD=
# --- Venue alert bots (Telegram) ---------------------------------------------
# TWO bots run side by side during the staged migration described in
# specs/telegram-miniapp-restaurant.md §7. This is deliberate, not leftovers:
# a new bot may not write to a chat whose staff never pressed Start, and the old
# bot is the safety net that keeps the alert flowing until they do.
#
# The OLD notifications bot. Keep it set until the migration report
# (GET /api/v1/admin/notifications/telegram-migration) shows pending = 0.
TELEGRAM_NOTIFY_BOT_TOKEN=
# secret_token passed to the old bot's setWebhook; empty answers 404 on
# POST /api/v1/telegram/webhook and the buttons under alerts stop working.
TELEGRAM_NOTIFY_WEBHOOK_SECRET=
#
# The NEW staff bot (@book_eat_restaurants_bot). Empty = the migration is off
# and everything behaves exactly as before.
RESTAURANTS_BOT_TOKEN=
# The new bot's OWN secret_token — MUST be a different value from
# TELEGRAM_NOTIFY_WEBHOOK_SECRET. Gates POST /api/v1/telegram/staff-webhook,
# which is also where /start marks a venue as migrated.
RESTAURANTS_BOT_WEBHOOK_SECRET=
# How long a signed Telegram initData blob is accepted after Telegram stamped
# it. The venue mini app re-signs on every open, so this only bounds how long a
# LEAKED blob stays usable — keep it short. Empty = 1h.
MINIAPP_INITDATA_TTL=1h
