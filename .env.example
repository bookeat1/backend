# Copy to .env for local development. .env is git-ignored.
# Real environment variables (shell / Docker / orchestrator) take precedence.

# Application
APP_NAME=backend-core
APP_ENV=development       # development | staging | production
APP_URL=0.0.0.0:8080
APP_LOG_LEVEL=info         # debug | info | warn | error
APP_LOG_FORMAT=json        # json | text — text читаемее при локальной разработке
# Comma-separated allowed CORS origins. "*" allows any origin (no credentials);
# an explicit list echoes matching origins and permits credentials.
APP_CORS_ORIGINS=*
# Comma-separated IPs/CIDRs allowed to set X-Forwarded-For / X-Real-IP and
# have gin's ClientIP() (used by AccessLog's "ip" field and by
# middleware.RateLimit's per-IP buckets) believe them. Empty (default) means
# trust nobody — ClientIP() falls back to the raw TCP peer, which behind
# Caddy (see deploy/docker-compose.yml — `app` has no published port) is
# Caddy's own container address. Set this to Caddy's address on the compose
# network in deploy/.env for per-real-client IP resolution in prod/test.
APP_TRUSTED_PROXIES=

# Per-client-IP request budgets (middleware.RateLimit). One tier per route
# class — see that middleware's doc comment for which routes fall into which
# tier and why webhooks get their own profile. Master switch below; every
# *_LIMIT/*_WINDOW pair is "at most LIMIT requests per WINDOW, per client IP,
# per route".
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STRICT_LIMIT=5
RATE_LIMIT_STRICT_WINDOW=1m
RATE_LIMIT_SOFT_LIMIT=60
RATE_LIMIT_SOFT_WINDOW=1m
RATE_LIMIT_WEBHOOK_LIMIT=120
RATE_LIMIT_WEBHOOK_WINDOW=1m
RATE_LIMIT_DEFAULT_LIMIT=30
RATE_LIMIT_DEFAULT_WINDOW=1m
# Memory bound for the in-process limiter: a bucket untouched for IDLE_TTL is
# evicted, checked at most once per SWEEP_INTERVAL.
RATE_LIMIT_IDLE_TTL=10m
RATE_LIMIT_SWEEP_INTERVAL=1m

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=bookeat
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# DB connection pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m

# Auth
# RSA private key in PEM (generate: openssl genrsa 2048). One line with \n or a
# quoted multiline value. NEVER commit a real key.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_KID=bookeat-dev
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_OTP_TTL=5m
AUTH_OTP_RATE_PER_MIN=1
AUTH_OTP_RATE_PER_HOUR=5
AUTH_OTP_DEV_EXPOSE=false

# OTP delivery (login codes). A channel is enabled ONLY when its credentials are
# present; with none of them set the stub sender stays in place and the code is
# printed to the log in development (and withheld everywhere else). Documented
# in full, with where each value comes from, in deploy/.env.example.
OTP_CHANNEL_ORDER=telegram_gateway,whatsapp,sms
OTP_SEND_TIMEOUT=5s
# Budget for the WHOLE waterfall (all fallbacks together). Must stay below the
# HTTP server WriteTimeout (15s), otherwise the guest's connection dies while we
# are still paying providers.
OTP_DELIVERY_BUDGET=12s
# Telegram Gateway (gateway.telegram.org — the PAID code-to-phone product, not
# the notifications bot).
OTP_TELEGRAM_GATEWAY_TOKEN=
OTP_TELEGRAM_GATEWAY_SENDER_USERNAME=
# WhatsApp Cloud API (Meta). Needs an APPROVED authentication template.
OTP_WHATSAPP_ACCESS_TOKEN=
OTP_WHATSAPP_PHONE_NUMBER_ID=
OTP_WHATSAPP_TEMPLATE_NAME=bookeat_otp_en
# Must match the language the template was APPROVED in, or every send is
# rejected. "en" for bookeat_otp_en — confirmed by a live delivered message.
OTP_WHATSAPP_TEMPLATE_LANG=en
OTP_WHATSAPP_API_VERSION=v22.0
# Must match the approved template (Meta's authentication templates carry the
# "Copy code" button by default). Wrong value = every WhatsApp send fails.
OTP_WHATSAPP_COPY_CODE_BUTTON=true
# SMS, last resort: "" | twilio | mobizon.
OTP_SMS_PROVIDER=
OTP_SMS_TWILIO_ACCOUNT_SID=
OTP_SMS_TWILIO_AUTH_TOKEN=
OTP_SMS_TWILIO_FROM=
OTP_SMS_TWILIO_MESSAGING_SERVICE_SID=
OTP_SMS_MOBIZON_API_KEY=
OTP_SMS_MOBIZON_SENDER=

# Booking policy (global defaults). Any restaurant may override these per venue
# via the NULLABLE restaurants.booking_* / timezone / auto_confirm columns —
# NULL there means "use the value from here".
BOOKING_DEFAULT_DURATION_MINUTES=90
BOOKING_DEFAULT_BUFFER_MINUTES=0
BOOKING_DEFAULT_LEAD_MINUTES=60
BOOKING_DEFAULT_HORIZON_DAYS=60
BOOKING_DEFAULT_CANCEL_DEADLINE_MINUTES=180
BOOKING_DEFAULT_CONFIRM_SLA_MINUTES=120
BOOKING_DEFAULT_MAX_GUESTS=20
BOOKING_DEFAULT_AUTO_CONFIRM=true
BOOKING_DEFAULT_CONFIRM_ON_CREATE=false
BOOTSTRAP_ADMIN_EMAIL=
# IANA name used when restaurants.timezone is NULL
BOOKING_TIMEZONE_FALLBACK=Asia/Almaty
# Anti-fraud: at most BOOKING_RATE_LIMIT booking attempts per normalized phone
# within BOOKING_RATE_WINDOW (Go duration).
BOOKING_RATE_LIMIT=10
BOOKING_RATE_WINDOW=1h
# Background booking worker (cmd/worker)
# How often the worker wakes up (Go duration).
WORKER_TICK_INTERVAL=1m
# How long after ends_at a booking is left alone before it is closed as
# completed (guest had arrived) or no_show (guest was never marked arrived).
WORKER_NO_SHOW_GRACE=30m
# How long before starts_at the guest gets their pre-visit reminder. One
# reminder per booking (the old Supabase system sent two, at 60 and 30 minutes).
# Pre-visit guest reminder. OFF by default: while the old Supabase system is
# still reminding the same guests, ours would be a second message about one
# visit. Turn on only once the old reminder path is dead.
WORKER_GUEST_REMINDERS_ENABLED=false
WORKER_GUEST_REMINDER_LEAD=1h
# Bookings claimed per pass (FOR UPDATE SKIP LOCKED batch size).
WORKER_BATCH_SIZE=100

# Guest mobile push (the Expo/React Native app). Empty = the channel is a clean
# no-op: the dispatcher still drains the outbox, guests just get nothing. The
# only implemented provider is "expo".
GUEST_PUSH_PROVIDER=
# Expo's OPTIONAL push-security token. A credential — never commit a real value.
# Expo accepts unauthenticated sends unless push security is enabled on the
# project, so leaving this empty does NOT disable the channel.
EXPO_ACCESS_TOKEN=
# Override Expo's push URL (tests / a future relay). Empty = the default.
EXPO_PUSH_ENDPOINT=
# Override Expo's getReceipts URL (tests / a relay). Empty = the default.
EXPO_RECEIPTS_ENDPOINT=

# Guest push RECEIPTS. A provider ticket only says "accepted": the per-device
# outcome (delivered / DeviceNotRegistered) appears later, in a receipt fetched
# by ticket id. The poller runs only when GUEST_PUSH_PROVIDER is set, and every
# value below has a working default — a deploy that sets none of them behaves
# exactly as described here.
# How often the poller wakes up.
PUSH_RECEIPTS_TICK_INTERVAL=15m
# How long a ticket ages before it is asked about. Expo suggests ~15 minutes;
# asking earlier mostly answers "no receipt yet".
PUSH_RECEIPTS_MIN_AGE=15m
# When an unanswered ticket is force-resolved. Clamped to 24h: Expo deletes
# receipts after that, so a longer value only grows the table.
PUSH_RECEIPTS_MAX_AGE=24h
# Ticket ids per provider request. Clamped to 1000 (Expo's hard limit).
PUSH_RECEIPTS_BATCH_SIZE=500
# Tickets one pass reads from the queue, i.e. the cap on requests per tick.
PUSH_RECEIPTS_MAX_PER_TICK=2000

# --- Static map proxy (GET /api/v1/restaurants/:id/map) -----------------------
# The map provider key stays on the SERVER: a key shipped inside the mobile app
# can be extracted from the installed bundle and every request made with it is
# billed to us. The app asks the backend for a picture instead.
#
# Empty provider = the endpoint still exists and answers 503 with
# code=map_not_configured, which the app renders as its normal "no map"
# placeholder. The only implemented provider is "2gis".
STATIC_MAP_PROVIDER=
# 2GIS Platform Manager access key. A credential — never commit a real value,
# never log it. Required when STATIC_MAP_PROVIDER=2gis.
STATIC_MAP_2GIS_API_KEY=
# Override 2GIS's Static API entry point (tests / staging).
# Empty = https://static.maps.2gis.com/2.0
STATIC_MAP_2GIS_BASE_URL=
# Cap on one provider render call. Must stay well inside the HTTP server's
# 15s write timeout.
STATIC_MAP_TIMEOUT=5s
# How long a rendered image is reused, and the max-age sent to the client.
# Restaurant coordinates change roughly never.
STATIC_MAP_CACHE_TTL=24h
# Memory bound of the in-process image cache, in bytes (64 MiB).
STATIC_MAP_CACHE_MAX_BYTES=67108864

# Granularity of generated bookable start times for venues that publish opening
# hours but no explicit restaurant_time_slots rows.
BOOKING_SLOT_STEP_MINUTES=30
# Payments (global defaults). A restaurant may override most of these per venue
# via the NULLABLE restaurants.payments_enabled / deposit_* /
# preorder_payment_required / service_fee_bps / payment_provider columns — NULL
# there means "use the value from here".
# Master switch: off by default. Turning payments on is a deliberate act.
PAYMENTS_ENABLED=false
# Acquirer used when the venue has no preference or its choice is disabled in
# the payment_providers registry: freedompay | tiptoppay
PAYMENTS_DEFAULT_PROVIDER=freedompay
# BookEat service fee charged to the guest, in basis points (350 = 3.5%).
PAYMENTS_SERVICE_FEE_BPS=350
# Withheld from a guest's refund to cover the acquirer's cost of reversing the
# payment, in basis points (100 = 1%). Owner decision 2026-07-25: 0 — nothing is
# taken off the guest's refund by default.
PAYMENTS_REFUND_ACQUIRING_BPS=0
# The acquirer's per-operation FLOOR in tiyn — the "минимум 25 ₸" half of
# FreedomPay's "3,5% мин 25 ₸" tariff. Without it a small deposit leaves the
# venue short, because the percentage markup would be less than the fee the
# acquirer actually takes. 0 = the tariff is pure percent.
PAYMENTS_ACQUIRER_MIN_FEE_MINOR=2500
# Per-acquirer override of the line above, because keeping (or returning) the fee
# on a reversal is the acquirer's rule, not ours. Unset = use the global rate;
# an explicit 0 means "this acquirer charges nothing to reverse".
# PAYMENTS_REFUND_ACQUIRING_BPS_FREEDOMPAY=0
# PAYMENTS_REFUND_ACQUIRING_BPS_TIPTOPPAY=0
# PAYMENTS_REFUND_ACQUIRING_BPS_PARTNERSPAY=0
# PAYMENTS_REFUND_ACQUIRING_BPS_KASPI=0
# Deposit per booking in tiyn (100 = 1 ₸) when the venue requires one but sets
# no amount of its own. 0 = no default deposit.
PAYMENTS_DEPOSIT_DEFAULT_MINOR=0
# Global fallback for restaurants.deposit_required / preorder_payment_required
# when a venue sets neither override column. Without these, a restaurant
# running on the global defaults could never take a payment at all (payments
# review 2026-07-23, item #10) — a venue's own override still wins when set.
PAYMENTS_DEPOSIT_REQUIRED=false
PAYMENTS_PREORDER_PAYMENT_REQUIRED=false
# How long an authorization (hold) is expected to stay valid (Go duration).
# The acquirer has the final say; this drives payments.expires_at.
# FreedomPay auto-clears an uncleared two-stage hold after 5 days, so a longer
# TTL would silently charge the guest instead of expiring. Verify on sandbox.
PAYMENTS_HOLD_TTL=96h
# This backend's own externally-reachable origin (no trailing slash), used
# ONLY to build the acquirer webhook CallbackURL server-side — never taken
# from the client. Required for POST /bookings/{id}/payment to work at all
# (FreedomPay needs somewhere to call back); leave unset in an environment
# with no public URL yet and that route answers 422, not a silent no-op.
PAYMENTS_PUBLIC_BASE_URL=https://api.bookeat.kz

# Background payments reconciliation worker (usecase/payments.Reconciler).
# KNOWN GAP: read here, but not yet started from cmd/worker — that needs a
# real Postgres implementation of the payments repositories, which does not
# exist in this branch yet (only in-memory test fakes do).
# How often the worker wakes up (Go duration).
PAYMENTS_RECONCILE_TICK_INTERVAL=2m
# How long a payment may sit in `capturing`/`voiding`, or a refund in
# `in_flight`/`pending`, before it counts as stuck rather than a normal
# request still in flight.
PAYMENTS_RECONCILE_STUCK_AFTER=10m
# How long a `created`/`authorized` payment with a provider payment id may go
# without a status change before the worker asks the acquirer directly, in
# case its webhook was lost. Deliberately much longer than STUCK_AFTER: an
# authorized hold sitting untouched for hours is completely normal.
PAYMENTS_RECONCILE_LOST_WEBHOOK_AFTER=1h
# Rows claimed per pass, per stage (FOR UPDATE SKIP LOCKED batch size).
PAYMENTS_RECONCILE_BATCH_SIZE=50
# Consecutive unresolved attempts before a row is flagged NeedsManualReview
# and the worker stops calling the acquirer for it — build a Grafana alert on
# the payment.reconcile_manual_review event, not on this number directly.
PAYMENTS_RECONCILE_MAX_ATTEMPTS=5
# Minimum spacing between two acquirer calls this worker makes (avalanche
# guard): a batch of many stuck rows must not become simultaneous requests.
PAYMENTS_RECONCILE_PROVIDER_MIN_GAP=200ms

# Acquirer credentials are NOT listed here on purpose: each adapter reads its
# own keys from env (FREEDOMPAY_*, TIPTOPPAY_*, KASPI_*) and they never reach the DB.

# Kaspi Pay — reached through OUR OWN multi-tenant Kaspi service
# (kaspi.book-eat.com), not Kaspi directly. The adapter is SKIPPED entirely
# unless both KASPI_COMPANY_API_KEYS and KASPI_WEBHOOK_SECRETS are set, so an
# unconfigured deployment simply has no Kaspi provider.
#
# !! Kaspi has NO SANDBOX. Every payment link this creates is real money.
KASPI_API_URL=https://kaspi.book-eat.com
# "<companyId>=<key>,<companyId>=<key>" — one X-Api-Key per company in the
# Kaspi service. A venue is pointed at a company from the admin panel
# (PUT /admin/restaurants/:id/payment-settings/acquirer-account, superadmin),
# which stores ONLY the company id; the key lives here and nowhere else.
KASPI_COMPANY_API_KEYS=
# "<companyId>=<secret>,…" — HMAC-SHA256 secrets of the webhook subscriptions
# the Kaspi service delivers to POST /api/v1/webhooks/payments/kaspi
# (header X-Webhook-Signature: sha256=<hex>). A single bare value is accepted
# as one shared secret.
KASPI_WEBHOOK_SECRETS=
# Optional: the Kaspi service sits behind Caddy basic auth on everything except
# its own /webhooks* paths. Leave blank when reaching it on a private network.
KASPI_BASIC_AUTH_USER=
KASPI_BASIC_AUTH_PASSWORD=
# The superadmin's «Приём оплаты» picker (GET /api/v1/admin/kaspi/companies)
# reads the Kaspi service's company registry with the same URL and basic auth.
# That read is the ONLY thing these two add, and it is read-only — Kaspi has no
# sandbox, so nothing there may ever create a payment.
# Optional: set only if the Kaspi service itself has ADMIN_TOKEN configured,
# which makes it demand X-Admin-Token on its platform routes.
KASPI_ADMIN_TOKEN=
# Budget for one directory read ("5s", or a bare number of seconds). Default 5s.
# KASPI_DIRECTORY_TIMEOUT=5s

# Media upload (Cloudflare R2)
# The admin panel's image-upload endpoint (POST /admin/media/images) stores
# originals in an R2 bucket and returns their public URL. This whole feature is
# OPTIONAL: with none of the R2_* vars set the endpoint returns 503 "not
# configured" and the server still boots. To ENABLE it, all four of ENDPOINT,
# ACCESS_KEY_ID, SECRET_ACCESS_KEY and PUBLIC_BASE must be present (BUCKET has a
# default). The three secrets are never logged.
# S3 API endpoint of the R2 account, e.g. https://<account>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name. Defaults to book-eat-media when unset.
R2_BUCKET=book-eat-media
# Public read origin the bucket is served from (managed r2.dev or a custom
# domain), NO trailing slash. An object at key <k> is served at <base>/<k>.
# Required to enable uploads: without it the endpoint stays 503 (we would have
# no URL to return).
R2_PUBLIC_BASE=https://pub-41b6f06fc8e74b6e959cdd6def081e22.r2.dev
